# Reference: <https://postmarketos.org/devicepkg>
pkgname=device-sony-maple
pkgdesc="Sony Xperia XZ Premium"
pkgver=1
pkgrel=18
url="https://postmarketos.org"
license="MIT"
arch="aarch64"
options="!check !archcheck"
depends="
	firmware-sony-maple
	linux-firmware-ath10k
	linux-sony-maple
	mkbootimg
	postmarketos-base
	qcom-diag
	reboot-mode
	rmtfs
	ta-service-yoshino
	swclock-offset
	tqftpserv
"
install="$pkgname.post-install"
subpackages="$pkgname-openrc:openrc $pkgname-lomiri:lomiri"

openrc() {
	install_if="$pkgname=$pkgver-r$pkgrel openrc"
	depends="rmtfs-openrc tqftpserv-openrc ta-service-yoshino-openrc qcom-diag-openrc"
	mkdir -p "$subpkgdir"
}
lomiri() {
	pkgdesc="Lomiri profile and missing dependencies for the Xperia XZ Premium"
	install_if="$pkgname=$pkgver-r$pkgrel postmarketos-ui-lomiri"
	depends="lomiri-ui-extras-qt5 maliit-keyboard"
	install -Dm644 "$srcdir"/maple-lomiri-deviceinfo.yaml \
		"$subpkgdir"/etc/lomiri-deviceinfo/devices/maple.yaml
}
makedepends="devicepkg-dev"
source="deviceinfo 50-maple-sdlog.sh maple-init 00-maple-init.files maple-watchdog.start maple-bt.start unudhcpd.usb0.confd 10-wifi-powersave-off.conf maple-dsp.start maple-HiFi.conf maple-ucm.conf maple-gtk4-renderer.sh maple-lomiri-deviceinfo.yaml"

build() {
	devicepkg_build $startdir $pkgname
}

package() {
	devicepkg_package $startdir $pkgname
	install -Dm755 "$srcdir"/50-maple-sdlog.sh "$pkgdir"/usr/share/mkinitfs/hooks/50-maple-sdlog.sh
	install -Dm755 "$srcdir"/maple-init "$pkgdir"/usr/share/maple/maple-init
	install -Dm644 "$srcdir"/00-maple-init.files "$pkgdir"/usr/share/mkinitfs/files/00-maple-init.files
	install -Dm755 "$srcdir"/maple-watchdog.start "$pkgdir"/etc/local.d/maple-watchdog.start
	install -Dm755 "$srcdir"/maple-bt.start "$pkgdir"/etc/local.d/maple-bt.start
	install -Dm755 "$srcdir"/maple-dsp.start "$pkgdir"/etc/local.d/maple-dsp.start
	install -Dm644 "$srcdir"/maple-HiFi.conf "$pkgdir"/usr/share/alsa/ucm2/Sony/maple/HiFi.conf
	install -Dm644 "$srcdir"/maple-gtk4-renderer.sh "$pkgdir"/etc/profile.d/maple-gtk4-renderer.sh
	install -Dm644 "$srcdir"/maple-ucm.conf "$pkgdir"/usr/share/alsa/ucm2/conf.d/apq8096/Xperia-XZ-Premium.conf
	install -Dm644 "$srcdir"/unudhcpd.usb0.confd "$pkgdir"/etc/conf.d/unudhcpd.usb0
	install -Dm644 "$srcdir"/10-wifi-powersave-off.conf "$pkgdir"/etc/NetworkManager/conf.d/10-wifi-powersave-off.conf
}

