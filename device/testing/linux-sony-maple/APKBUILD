# Mainline kernel (msm8998-mainline fork) for Sony Xperia XZ Premium
_flavor="sony-maple"
pkgname=linux-$_flavor
pkgver=6.18
pkgrel=0
_commit="10875f80c16d0c70f86f233827243f3bd9d7ad63"
pkgdesc="Mainline kernel fork for Sony Xperia XZ Premium"
arch="aarch64"
_carch="arm64"
url="https://github.com/Boomerangz/linux"
license="GPL-2.0-only"
options="!strip !check !tracedeps pmb:cross-native"
makedepends="bash python3 py3-lxml bison findutils flex linux-headers openssl-dev perl postmarketos-installkernel xz"
source="$url/archive/$_commit/linux-$_commit.tar.gz"
builddir="$srcdir/linux-$_commit"

prepare() {
	default_prepare
	make ARCH="$_carch" msm8998_defconfig maple.config
}

build() {
	unset LDFLAGS
	make ARCH="$_carch" CC="${CC:-gcc}" \
		KBUILD_BUILD_VERSION="$((pkgrel + 1))-$_flavor"
}

package() {
	mkdir -p "$pkgdir"/boot
	make zinstall dtbs_install \
		ARCH="$_carch" \
		INSTALL_PATH="$pkgdir"/boot \
		INSTALL_DTBS_PATH="$pkgdir"/boot/dtbs
	install -D "$builddir"/include/config/kernel.release \
		"$pkgdir"/usr/share/kernel/$_flavor/kernel.release
}

sha512sums="
30b34fe5ba1f93224341edc1630fba8509cbc8469d3bc807ded0ea99428b25dfea00565cee895b4ba7bf8a8012cbc97f6674a7fe82154ce4b09fdb9f2b27b842  linux-10875f80c16d0c70f86f233827243f3bd9d7ad63.tar.gz
"
