pkgname=ta-service-yoshino
pkgver=0_git20180925
pkgrel=0
pkgdesc="Trim Area and modem log QMI services (227-230) needed by Sony modems"
url="https://github.com/andersson/ta-service"
arch="aarch64"
license="BSD-3-Clause"
makedepends="qrtr-dev linux-headers"
subpackages="$pkgname-openrc"
options="!check"
provides="ta-service"
replaces="ta-service"
source="main.c ta.c ta.h qmi_ta227.c qmi_ta227.h qmi_ta228.c qmi_ta228.h qmi_svc229.c qmi_svc229.h Makefile ta-service-yoshino.initd"
builddir="$srcdir"

build() {
	make
}

package() {
	install -Dm755 ta-service "$pkgdir"/usr/bin/ta-service
	install -Dm755 "$srcdir"/ta-service-yoshino.initd "$pkgdir"/etc/init.d/ta-service
}
